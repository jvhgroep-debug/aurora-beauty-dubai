---
import type { FaqItem } from '../types';

interface Props {
  faqs: FaqItem[];
  locatieNaam: string;
  faqTitle?: string;
}

const { faqs, locatieNaam, faqTitle } = Astro.props;
const heading = faqTitle ?? `Beauty Salon FAQ — ${locatieNaam}`;
---

<section id="faq" class="py-16 md:py-24 bg-aurora-white border-t border-aurora-sand/60">
  <div class="mx-auto max-w-3xl px-4 md:px-8">
    <div class="text-center mb-10">
      <p class="section-label mb-2">Questions & Answers</p>
      <h2 class="text-xl md:text-2xl font-semibold uppercase tracking-wider text-aurora-dark">
        {heading}
      </h2>
      <p class="mt-3 text-sm text-aurora-brown/80">
        Common questions from clients in {locatieNaam} about Aurora Beauty Lounge.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group border border-aurora-sand/80 bg-aurora-cream open:bg-white transition-colors">
          <summary class="cursor-pointer list-none px-5 py-4 flex items-center justify-between gap-4">
            <span class="text-sm md:text-base font-medium text-aurora-dark pr-4">{faq.question}</span>
            <span class="shrink-0 text-aurora-brown group-open:rotate-45 transition-transform text-xl leading-none" aria-hidden="true">+</span>
          </summary>
          <div class="px-5 pb-5 text-sm text-aurora-brown/90 leading-relaxed border-t border-aurora-sand/50 pt-4">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
