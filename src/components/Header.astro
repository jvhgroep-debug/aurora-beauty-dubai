---
import site from '/src/data/site.json';

interface Props {
  locatieNaam?: string;
  isHomeBase?: boolean;
  isSiteHomepage?: boolean;
}

const { locatieNaam, isHomeBase = false, isSiteHomepage = false } = Astro.props;
const homeUrl = isSiteHomepage ? '/' : `/${site.homeBaseSlug}/`;
---

<header class="sticky top-0 z-40 bg-aurora-cream/95 backdrop-blur-sm border-b border-aurora-sand/50">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 md:px-8">
    <a href={homeUrl} class="group">
      <span class="block font-serif text-3xl md:text-4xl font-semibold text-aurora-dark leading-none">
        Aurora
      </span>
      <span class="block text-[10px] tracking-[0.3em] uppercase text-aurora-brown mt-0.5">
        {site.tagline}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      <a href={homeUrl} class="text-xs uppercase tracking-widest text-aurora-dark hover:text-aurora-brown transition-colors">Home</a>
      <a href="#about" class="text-xs uppercase tracking-widest text-aurora-dark hover:text-aurora-brown transition-colors">About</a>
      <a href="#services" class="text-xs uppercase tracking-widest text-aurora-dark hover:text-aurora-brown transition-colors">Services</a>
      <a href="#testimonials" class="text-xs uppercase tracking-widest text-aurora-dark hover:text-aurora-brown transition-colors">Testimonials</a>
      <a href="#contact" class="text-xs uppercase tracking-widest text-aurora-dark hover:text-aurora-brown transition-colors">Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 rounded-full bg-white border border-aurora-sand px-5 py-2 text-xs font-semibold uppercase tracking-wider text-aurora-dark shadow-sm hover:shadow transition-shadow"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Book Now
      </a>
    </div>
  </div>
  {isSiteHomepage && (
    <div class="bg-aurora-dark py-1.5 text-center">
      <p class="text-xs tracking-widest uppercase text-white/80">
        Azizi Riviera 40, Shop 10, Meydan — Luxury Beauty Salon Dubai
      </p>
    </div>
  )}
  {locatieNaam && !isHomeBase && !isSiteHomepage && (
    <div class="bg-aurora-sand/40 py-1.5 text-center">
      <p class="text-xs tracking-widest uppercase text-aurora-brown">
        Serving {locatieNaam}, Dubai —{' '}
        <a href={homeUrl} class="underline underline-offset-2 hover:text-aurora-dark">Visit our Azizi Riviera salon</a>
      </p>
    </div>
  )}
  {isHomeBase && !isSiteHomepage && (
    <div class="bg-aurora-dark py-1.5 text-center">
      <p class="text-xs tracking-widest uppercase text-white/80">
        Home Base — Azizi Riviera 40, Shop 10, Meydan
      </p>
    </div>
  )}
</header>
