---
import type { Testimonial } from '../types';
import images from '/src/data/images.json';
import site from '/src/data/site.json';

interface Props {
  testimonials: Testimonial[];
  locatieNaam?: string;
}

const { testimonials, locatieNaam } = Astro.props;
const ctaImage = images.sections.ctaBanner;
---

<section id="testimonials" class="py-16 md:py-24 bg-aurora-dark text-white">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="text-center mb-12">
      <p class="font-script text-aurora-gold text-xl md:text-2xl mb-2">What Our Clients Say</p>
      <h2 class="text-2xl md:text-4xl font-semibold uppercase tracking-wider">
        Client Testimonials
        {locatieNaam && locatieNaam !== "Dubai" && <span class="block text-base font-normal normal-case tracking-normal text-white/60 mt-2">Trusted by clients across Dubai, including {locatieNaam}</span>}
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <blockquote class="bg-aurora-charcoal/60 border border-white/10 p-6 md:p-8">
          <p class="text-white/80 leading-relaxed mb-6 text-sm italic">"{t.quote}"</p>
          <footer>
            <cite class="not-italic">
              <span class="block text-sm font-semibold uppercase tracking-wider">{t.name}</span>
              <span class="block text-xs text-aurora-gold mt-1">{t.location}</span>
            </cite>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<!-- CTA banner -->
<section class="relative py-20 md:py-28 overflow-hidden">
  <div class="absolute inset-0">
    <img
      src={ctaImage.src}
      alt={ctaImage.alt}
      width={1920}
      height={1080}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-aurora-dark/60"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-8 text-center text-white">
    <p class="font-script text-aurora-gold text-xl mb-3">Luxe Beauty Redefined</p>
    <h2 class="text-2xl md:text-4xl font-semibold uppercase tracking-wider mb-8">
      A Symphony of Style and Sophistication
    </h2>
    <a
      href={site.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary bg-white text-aurora-dark hover:bg-aurora-cream"
    >
      Book Your Visit
    </a>
  </div>
</section>
