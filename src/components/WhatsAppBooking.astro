---
import site from '/src/data/site.json';
const phone = site.phone.replace(/\D/g, '');
const directUrl = `https://wa.me/${phone}?text=${encodeURIComponent('Hello Aurora Beauty Lounge! I found you on aurorasalondubai.com and would like to ask about a treatment or book an appointment.')}`;
---
<a id="aurora-whatsapp-open" href={directUrl} target="_blank" rel="noopener noreferrer" aria-label="Ask Aurora or request an appointment on WhatsApp" aria-haspopup="dialog" class="whatsapp-launcher">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="25" height="25" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  <span>WhatsApp</span>
</a>
<dialog id="aurora-whatsapp-dialog" aria-labelledby="aurora-whatsapp-title" aria-describedby="aurora-whatsapp-description">
  <div class="whatsapp-heading"><div><p>AURORA BY TOLOU</p><h2 id="aurora-whatsapp-title">How can we help?</h2></div><button type="button" id="aurora-whatsapp-close" aria-label="Close WhatsApp enquiry">×</button></div>
  <p id="aurora-whatsapp-description">Answer a few quick questions, then send your request to our salon on WhatsApp.</p>
  <form id="aurora-whatsapp-form" data-phone={phone}>
    <label for="aurora-treatment">Which treatment are you interested in?</label>
    <select id="aurora-treatment" name="treatment" required autofocus>
      <option value="" selected disabled>Choose a treatment</option>
      <option>VIP facial</option><option>Classic lash extensions — full set</option><option>Volume lash infill</option><option>Mega volume lashes</option><option>L/M curl extensions</option><option>Kim Kardashian style lashes</option><option>Eyebrow lamination</option><option>Manicure, pedicure &amp; lashes package</option><option>I need advice / another treatment</option>
    </select>
    <div class="whatsapp-fields"><div><label for="aurora-date">Preferred date <small>(optional)</small></label><input id="aurora-date" name="date" type="date" /></div><div><label for="aurora-time">Preferred time</label><select id="aurora-time" name="time"><option>I'm flexible</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></div></div>
    <label for="aurora-name">Your name <small>(optional)</small></label><input id="aurora-name" name="name" autocomplete="given-name" maxlength="80" placeholder="Your first name" />
    <label for="aurora-notes">Anything else? <small>(optional)</small></label><textarea id="aurora-notes" name="notes" rows="2" maxlength="500" placeholder="Your question or a specific preferred time"></textarea>
    <p class="whatsapp-note">Times are in Dubai time. Your appointment is confirmed only after our team replies.</p>
    <button class="whatsapp-send" type="submit">Continue to WhatsApp <span aria-hidden="true">→</span></button>
  </form>
  <a class="whatsapp-direct" href={directUrl} target="_blank" rel="noopener noreferrer">Just ask a question on WhatsApp</a>
</dialog>
<style>
.whatsapp-launcher{position:fixed;right:20px;bottom:max(20px,env(safe-area-inset-bottom));z-index:50;display:flex;align-items:center;gap:9px;padding:15px 19px;border-radius:999px;background:#146c43;color:white;box-shadow:0 5px 22px #0003;font:600 14px Montserrat,sans-serif;text-decoration:none;min-height:54px}.whatsapp-launcher:hover{background:#105735}.whatsapp-launcher:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid #ba985f;outline-offset:4px}dialog{width:min(440px,calc(100vw - 28px));max-height:calc(100dvh - 36px);padding:25px;border:1px solid #ded3c3;border-radius:18px;background:#fffcf6;color:#30291f;box-shadow:0 20px 70px #0004;margin:auto;overflow-y:auto;overscroll-behavior:contain;font:14px Montserrat,sans-serif}dialog::backdrop{background:#19150fb3}.whatsapp-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}.whatsapp-heading p{font-size:10px;letter-spacing:2px;color:#786443;margin:0 0 7px}.whatsapp-heading h2{font:600 28px 'Cormorant Garamond',serif;margin:0}.whatsapp-heading button{background:none;border:0;font-size:29px;line-height:1;color:#534637;cursor:pointer;min-width:44px;min-height:44px}#aurora-whatsapp-description{line-height:1.6;color:#685e50;margin:14px 0 20px}label{display:block;font-size:12px;font-weight:600;margin:14px 0 7px}small{font-weight:400;color:#706453}input,select,textarea{display:block;width:100%;min-width:0;min-height:45px;border:1px solid #c6bbaa;border-radius:8px;background:white;padding:10px;color:#30291f;font:16px Montserrat,sans-serif;box-sizing:border-box}input:focus,select:focus,textarea:focus{outline:2px solid #947b4e;outline-offset:1px}.whatsapp-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.whatsapp-fields>div{min-width:0}.whatsapp-note{font-size:11px;color:#685e50;line-height:1.6;margin:14px 0}.whatsapp-send{display:flex;align-items:center;justify-content:space-between;width:100%;border:0;border-radius:9px;padding:15px;background:#146c43;color:white;font:600 14px Montserrat,sans-serif;cursor:pointer;min-height:49px}.whatsapp-direct{display:block;text-align:center;color:#51452f;font-size:12px;margin-top:17px;text-decoration:underline;text-underline-offset:3px}@media(max-width:360px){dialog{padding:18px}.whatsapp-fields{grid-template-columns:1fr}}
</style>
<script>
  const launcher = document.querySelector<HTMLAnchorElement>('#aurora-whatsapp-open');
  const dialog = document.querySelector<HTMLDialogElement>('#aurora-whatsapp-dialog');
  const form = document.querySelector<HTMLFormElement>('#aurora-whatsapp-form');
  const close = document.querySelector<HTMLButtonElement>('#aurora-whatsapp-close');
  const date = document.querySelector<HTMLInputElement>('#aurora-date');
  if (launcher && dialog && form && close && typeof dialog.showModal === 'function') {
    launcher.addEventListener('click', (event) => {
      event.preventDefault();
      if (date) {
        const parts = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Dubai', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
        const part = (name: string) => parts.find((p) => p.type === name)?.value;
        date.min = `${part('year')}-${part('month')}-${part('day')}`;
      }
      dialog.showModal();
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => launcher.focus());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) || '').trim();
      const message = [
        'Hello Aurora Beauty Lounge! I would like to enquire about an appointment.',
        '',
        `Treatment: ${value('treatment')}`,
        `Preferred date: ${value('date') || "I'm flexible"}`,
        `Preferred time (Dubai): ${value('time')}`,
        ...(value('name') ? [`Name: ${value('name')}`] : []),
        ...(value('notes') ? [`Question / notes: ${value('notes')}`] : []),
        '',
        'Please let me know your availability. I understand this is a request, not a confirmed booking.',
        'Enquiry via aurorasalondubai.com',
        `Page: ${window.location.origin}${window.location.pathname}`,
      ].join('\n');
      window.location.assign(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`);
    });
  }
</script>
