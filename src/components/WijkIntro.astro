---
interface Props {
  naam: string;
  beschrijving: string;
  isHomeBase?: boolean;
}

const { naam, beschrijving, isHomeBase = false } = Astro.props;
---

<section id="about" class="py-14 md:py-20 bg-aurora-sand/30">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="max-w-3xl">
      <p class="section-label mb-2">
        {isHomeBase ? 'Our Neighbourhood' : `About ${naam}`}
      </p>
      <h2 class="text-xl md:text-2xl font-semibold uppercase tracking-wider text-aurora-dark mb-6">
        {isHomeBase ? 'Beauty Salon in Azizi Riviera, Meydan' : `Life in ${naam}`}
      </h2>
      <p class="text-aurora-brown/90 leading-relaxed text-base md:text-lg">
        {beschrijving}
      </p>
    </div>
  </div>
</section>
