---
import LocatiePage from '../components/LocatiePage.astro';
import locaties from '/src/data/locaties.json';
import type { Locatie } from '../types';

export async function getStaticPaths() {
  return locaties.map((locatie) => ({
    params: { wijk: locatie.wijkSlug },
    props: { locatie },
  }));
}

interface Props {
  locatie: Locatie;
}

const { locatie } = Astro.props;
---

<LocatiePage locatie={locatie} canonicalUrl={`/${locatie.slug}/`} />
