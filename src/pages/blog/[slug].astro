---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { publishedBlogPosts } from '../../data/blog';
import site from '../../data/site.json';
export function getStaticPaths() { return publishedBlogPosts.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const url = `${site.siteUrl}/blog/${post.slug}/`;
const approvedImage = post.imageApproved ? post.image : null;
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.heading, description: post.description, url, mainEntityOfPage: url, datePublished: post.datePublished, dateModified: post.dateModified ?? '2026-10-16T12:24:00+04:00', inLanguage: 'en', ...(approvedImage ? { image: new URL(approvedImage, site.siteUrl).href } : {}), author: { '@type': 'Organization', name: 'Aurora Beauty Lounge by Tolou', url: site.siteUrl }, publisher: { '@type': 'Organization', name: site.name, url: site.siteUrl } };
---
<BlogLayout title={post.title} description={post.description} socialImage={approvedImage}>
  <p class="mb-6 text-sm"><a href="/blog/" class="underline underline-offset-4">← Aurora Journal</a></p>
  <article>
    <header><p class="section-label mb-3">Your salon visit</p><h1 class="section-heading mb-6">{post.heading}</h1><p class="mb-8 text-sm"><time datetime={post.datePublished}>{post.datePublished.slice(0, 10)}</time> · Aurora Beauty Lounge by Tolou</p></header>
    {approvedImage && <img src={approvedImage} alt={post.imageAlt} width={post.imageWidth ?? 1500} height={post.imageHeight ?? 1000} class:list={['mb-10 max-w-full object-cover', post.imageWidth ? 'h-auto' : 'aspect-[3/2] w-full']} fetchpriority="high" />}
    <p class="mb-10 text-lg leading-relaxed">{post.intro}</p>
    {post.sections.map(section => <section class="mb-10"><h2 class="mb-4 text-xl font-semibold md:text-2xl">{section.heading}</h2>{section.paragraphs.map(paragraph => <p class="mb-4 leading-relaxed">{paragraph}</p>)}{'href' in section && <a href={section.href} class="font-semibold underline underline-offset-4">{section.label} →</a>}</section>)}
    <aside class="border border-aurora-sand bg-aurora-white p-7">
      <h2 class="mb-4 text-2xl font-semibold">Choose a treatment at our Azizi Riviera salon</h2>
      <p class="mb-5 leading-relaxed">All appointments take place at Azizi Riviera 40, Shop 10, Meydan, Dubai. Compare the listed treatments and AED prices, then confirm the service and time that suit your visit.</p>
      <ul class="mb-6 grid gap-3 text-sm sm:grid-cols-2">
        <li><a href="/beautysalon-azizi-riviera/#treatment-vip-facial" class="underline underline-offset-4">VIP Facial: treatment and price</a></li>
        <li><a href="/beautysalon-azizi-riviera/#treatment-lash-lift" class="underline underline-offset-4">Classic lash extensions: full set</a></li>
        <li><a href="/beautysalon-azizi-riviera/#treatment-volume-lash" class="underline underline-offset-4">Volume lash infill</a></li>
        <li><a href="/beautysalon-azizi-riviera/#treatment-brow-lamination" class="underline underline-offset-4">Eyebrow lamination</a></li>
        <li><a href="/beautysalon-azizi-riviera/#treatment-vip-special" class="underline underline-offset-4">Manicure, pedicure and lashes package</a></li>
        <li><a href="/beautysalon-azizi-riviera/#visit-salon-title" class="underline underline-offset-4">Salon address and directions in Meydan</a></li>
      </ul>
      <p class="mb-6 text-sm leading-relaxed">For help choosing a service, use the WhatsApp questions button or call <a href="tel:+971503181009" class="underline underline-offset-4">{site.phone}</a>. Appointment availability is confirmed through the booking system or by the salon.</p>
      <a href={site.bookingUrl} class="btn-primary" target="_blank" rel="noopener noreferrer">Check appointments</a>
    </aside>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</BlogLayout>
