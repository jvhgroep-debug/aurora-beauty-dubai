---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import NearbyAreas from '../components/NearbyAreas.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import homepage from '/src/data/homepage.json';
import locaties from '/src/data/locaties.json';
import services from '/src/data/services.json';
import testimonials from '/src/data/testimonials.json';
import { buildHomepageSchema, buildHomepageFaqSchema } from '../utils/schema';
import type { Locatie, NearbyLocatie } from '../types';

const locatieMap = new Map(locaties.map((l) => [l.wijkSlug, l]));

const featuredAreas: NearbyLocatie[] = homepage.featuredAreaSlugs
  .map((slug) => locatieMap.get(slug))
  .filter((l): l is Locatie => l !== undefined)
  .map((l) => ({ wijkSlug: l.wijkSlug, naam: l.naam, slug: l.slug }));

const schemaGraph = [
  ...buildHomepageSchema(),
  buildHomepageFaqSchema(homepage.faqs),
];
---

<BaseLayout
  title={homepage.seoTitle}
  description={homepage.metaDescription}
  canonicalUrl="/"
>
  <Header isSiteHomepage={true} />
  <main>
    <Hero
      h1={homepage.h1}
      tagline={homepage.heroTagline}
      heroImage={homepage.heroImage}
      heroImageAlt={homepage.heroImageAlt}
      isSiteHomepage={true}
      subtitle={homepage.heroSubtitle}
    />
    <section id="about" class="py-14 md:py-20 bg-aurora-sand/30">
      <div class="mx-auto max-w-7xl px-4 md:px-8">
        <div class="max-w-3xl">
          <p class="section-label mb-2">{homepage.aboutLabel}</p>
          <h2 class="text-xl md:text-2xl font-semibold uppercase tracking-wider text-aurora-dark mb-6">
            {homepage.aboutTitle}
          </h2>
          <p class="text-aurora-brown/90 leading-relaxed text-base md:text-lg">
            {homepage.aboutText}
          </p>
          <a href="/beautysalon-azizi-riviera/" class="inline-block mt-6 text-sm font-semibold underline underline-offset-4">Visit our Azizi Riviera salon: location, treatments and directions</a>
        </div>
      </div>
    </section>
    <ServiceGrid
      services={services}
      sectionTitle={homepage.sectionTitle}
      intro={homepage.intro}
    />
    <Testimonials
      testimonials={testimonials}
      locatieNaam="Dubai"
    />
    <Faq faqs={homepage.faqs} locatieNaam="Dubai" faqTitle="Luxury Beauty Salon FAQ — Dubai" />
    <NearbyAreas nearby={featuredAreas} />
    <section class="py-14 bg-aurora-sand/30" aria-labelledby="journal-heading">
      <div class="mx-auto max-w-7xl px-4 md:px-8"><p class="section-label mb-3">The Aurora Journal</p><h2 id="journal-heading" class="mb-5 text-2xl font-semibold">Plan your first salon visit</h2><p class="mb-5 max-w-2xl leading-relaxed">Explore our practical booking checklist for a visit to Aurora in Azizi Riviera, Meydan.</p><a class="font-semibold underline underline-offset-4" href="/blog/first-beauty-salon-visit-azizi-riviera-checklist/">Read the first-visit checklist →</a><p class="mt-4"><a href="/blog/" class="underline underline-offset-4">Explore the Aurora Journal</a></p></div>
    </section>
  </main>
  <Footer isSiteHomepage={true} />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
